{
  "name": "owlery-inbound-parse",
  "version": "0.1.0",
  "description": "Self-hosted SendGrid Inbound Parse receiver: saves each email to SQLite and can forward it to a Twilio Function",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/owlery-lab/owlery-inbound-parse.git"
  },
  "type": "module",
  "bin": {
    "owlery-inbound": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun --watch src/api/server.ts",
    "start": "bun src/api/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun src/core/db/index.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
