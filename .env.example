# === Server ===
PORT=3000
# Docker sets production automatically. Uncomment only for native `bun run dev`.
# NODE_ENV=development

# === Database ===
# Leave unset with Docker: the image uses /data/owlery-inbound.db, inside the
# owlery-data named volume. Native runs default to ./data/owlery-inbound.db.
# Only one process should open the database: keep it off shared or network
# folders, where SQLite's file locking doesn't work reliably.
# DB_PATH=./data/owlery-inbound.db

# === SendGrid Inbound Parse ===
# SendGrid sends these credentials because they're part of the Destination URL:
#   https://inbound:<pass>@<your-public-host>/sendgrid/inbound
# Use the same values here and in SendGrid. Generate the password with:
#   openssl rand -base64 32 | tr -d '=+/' | cut -c1-32
SENDGRID_INBOUND_BASIC_AUTH_USER=inbound
SENDGRID_INBOUND_BASIC_AUTH_PASS=change-me-to-a-long-random-string
# Comma-separated sender domains to accept, e.g. yourcompany.com,partner.com.
# Replace example.com with the domain(s) you'll send from. Empty accepts
# everyone, which is fine locally but not on a public URL.
SENDGRID_INBOUND_ALLOWED_SENDER_DOMAINS=example.com
# Directory attachments are written to (created if missing, 0700).
# Leave unset with Docker: the image uses /data/inbound-parse, inside the
# owlery-data volume. Setting ./data/... here would put attachments outside the
# volume, where a rebuild deletes them. Native runs default to ./data/inbound-parse.
# INBOUND_ATTACHMENTS_DIR=./data/inbound-parse
# Largest request accepted, in bytes. Bigger requests get a 413: right away if
# their Content-Length says so, otherwise once the bytes read cross the limit.
# Default 32 MB; SendGrid's own limit is 30 MB.
# INBOUND_MAX_BODY_BYTES=33554432

# === Signed webhooks (recommended) ===
# The public key from the SendGrid security policy attached to your Parse
# setting (signature.public_key in the API response). When set, every request
# needs a valid SendGrid signature as well as Basic Auth, or it gets a 401.
# Paste the base64 value on one line. A PEM "PUBLIC KEY" block also works, with
# \n for its line breaks. A malformed key stops the server from starting.
# Leave unset to check Basic Auth only.
# SENDGRID_INBOUND_VERIFICATION_KEY=<base64 public key from the security policy>
# How far the signed timestamp may be from this server's clock, in seconds,
# either way. SendGrid doesn't specify a window; 300 (5 minutes) is our choice.
# SENDGRID_INBOUND_SIGNATURE_TOLERANCE_SECONDS=300

# === Forwarding (optional) ===
# When both are set, each saved email is also POSTed to this URL as
# application/x-www-form-urlencoded (from, to, subject, text, envelope) with
# "Authorization: Bearer <token>". Leave unset to only store emails locally.
# A Twilio Function target must be public (.js), not .protected.js.
# TWILIO_FUNCTION_INBOUND_URL=https://your-service-xxxx.twil.io/api/inbound-email
# TWILIO_FUNCTION_INBOUND_TOKEN=long-random-string-shared-with-the-function
